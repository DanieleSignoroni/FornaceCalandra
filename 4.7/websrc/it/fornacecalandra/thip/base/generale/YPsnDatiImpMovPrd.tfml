<tfml>
  <generator type="form"/>
  <form classHdr="YPsnDatiImpMovPrd"
    name="YPsnDatiImpMovPrdForm"
    locktype="nolock"
    errorList="yes" menubar="yes" toolbar="yes" submitReset="none"
    servlet="com.thera.thermfw.web.servlet.FormActionAdapter"
    webFormModifierClass="it.thera.thip.cs.web.DatiPersWebFormModifier"
    jsLibraryName="it/fornacecalandra/thip/base/generale/YPsnDatiImpMovPrd.js"
    onLoadPresent="yes"
    header="com.thera.thermfw.common.Header.jsp"
    footer="com.thera.thermfw.common.Footer.jsp">
    <menubar  name="myMenuBar">
      <import file="it/thera/thip/cs/defObjMenu.tfml"/>
    </menubar>
    <toolbar name="myToolBar" imgwidth="16" imgheight="16">
      <import file="it/thera/thip/cs/defObjMenu.tfml"/>
    </toolbar>
    <tabbed name="mytabbed" height="100%" width="100%">
      <tab name="tab1" resourceFile="it.fornacecalandra.thip.base.generale.resources.YPsnDatiImpMovPrd" resourceID="tab1">
        <multisearchform name="SerieDocGenPrlLibero" classRD="SerieDocGenPrlLibero" additionalfields="1"/>
        <multisearchform name="SerieDocProdStrutture" classRD="SerieDocProdStrutture" additionalfields="1"/>
        <multisearchform name="CauDocGenPrlLibero" classRD="CauDocGenPrlLibero"/>
        <multisearchform name="CauDocPrdStrutture" classRD="CauDocPrdStrutture"/>
        <editgrid name="CausaliRigaDocStrutture" classCD="CausaliRigaDocStrutture" type="include">
          <column classAD="IdClasseD"/>
          <column classAD="IdAzienda" hidden="yes"/>
          <column classAD="ClasseD.Descrizione.Descrizione"/>
          <column classAD="IdCausaleRigaDocVrs"/>
          <column classAD="CausaleRigaDocVrsDist.Descrizione.Descrizione"/>
          <column classAD="TipoMq"/>
          <column classAD="Azienda.Descrizione" hideAsDefault="yes"/>
        </editgrid>
        <subform classCD="DatiComuniEstesi" name="DatiComuniEstesi"/>
      </tab>
    </tabbed>
  </form>
</tfml>

