<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE TDDML SYSTEM "../../../TDDML.dtd">
<TDDML>
  <!-- YCAU_RIG_DOC_PRD_STRUTTURE (YCAU_RI): Causali riga documento prod. strutt; -->
  <CreateTable schema="THIPPERS" name="YCAU_RIG_DOC_PRD_STRUTTURE" shortname="YCAU_RI">
    <Column name="ID_AZIENDA" shortname="ID_AZIEND0" type="char" length="3" nullable="no"/>
    <Column name="STATO" shortname="STAT0" type="char" length="1" nullable="no"/>
    <Column name="R_UTENTE_CRZ" shortname="R_UTENTE_0" type="char" length="20" nullable="yes"/>
    <Column name="TIMESTAMP_CRZ" shortname="TIMESTAMP0" type="timestamp" nullable="no" default="CURRENT TIMESTAMP"/>
    <Column name="R_UTENTE_AGG" shortname="R_UTENTE_1" type="char" length="20" nullable="yes"/>
    <Column name="TIMESTAMP_AGG" shortname="TIMESTAMP1" type="timestamp" nullable="no" default="CURRENT TIMESTAMP"/>
    <Column name="R_CLASSE_D" shortname="R_CLASSE_D" type="char" length="10" nullable="no"/>
    <Column name="R_CAU_RIGA_DOC_VRS" shortname="R_CAU_RIGA" type="char" length="3" nullable="yes"/>
    <Column name="TIPO_MQ" shortname="TIPO_MQ" type="char" length="1" nullable="no" default="-"/>
  </CreateTable>
  <CreateIndex schema="THIPPERS" name="YCAU_RIG_DOC_P_I01" tabschema="THIPPERS" tabname="YCAU_RIG_DOC_PRD_STRUTTURE" shortname="YCAU_R_I01" unique="yes">
    <IndexCol name="ID_AZIENDA" order="Asc"/>
    <IndexCol name="R_CLASSE_D" order="Asc"/>
  </CreateIndex>
  <AlterTable schema="THIPPERS" name="YCAU_RIG_DOC_PRD_STRUTTURE">
    <AddPrimaryKey>
      <PrimaryKey>
        <ColumnRef name="ID_AZIENDA"/>
        <ColumnRef name="R_CLASSE_D"/>
      </PrimaryKey>
    </AddPrimaryKey>
  </AlterTable>
  <Comment>
    <CommentTable schema="THIPPERS" name="YCAU_RIG_DOC_PRD_STRUTTURE" text="Causali riga documento prod. strutt">
      <CommentColumn name="ID_AZIENDA" text="Azienda"/>
      <CommentColumn name="STATO" text="Stato"/>
      <CommentColumn name="R_UTENTE_CRZ" text="Utente creazione"/>
      <CommentColumn name="TIMESTAMP_CRZ" text="Timestamp creazione"/>
      <CommentColumn name="R_UTENTE_AGG" text="Utente ultima modifica"/>
      <CommentColumn name="TIMESTAMP_AGG" text="Timestamp ultima modifica"/>
      <CommentColumn name="R_CLASSE_D" text="Classe D"/>
      <CommentColumn name="R_CAU_RIGA_DOC_VRS" text="Causale riga documento vrs distinta"/>
      <CommentColumn name="TIPO_MQ" text="Tipo MQ - Prodotti"/>
    </CommentTable>
    <CommentIndex schema="THIPPERS" name="YCAU_RIG_DOC_P_I01" text="Primary Key"/>
  </Comment>
  <Grant schema="THIPPERS" name="YCAU_RIG_DOC_PRD_STRUTTURE"/>
</TDDML>
